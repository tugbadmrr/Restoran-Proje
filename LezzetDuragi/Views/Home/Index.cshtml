@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center mt-5">
    <h1 class="display-3 fw-bold text-danger">🔥 Lezzet Durağı'na Hoş Geldiniz!</h1>
    <p class="lead text-muted mt-3">
        Şehrin en taze, en lezzetli yemeklerini sizin için hazırlıyoruz.
        Damak tadınıza uygun eşsiz lezzetler bir tık uzağınızda.
    </p>
    
    <hr class="my-5 w-50 mx-auto" />

    <div class="row mt-5">
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h3 class="card-title">🍲 Taze Malzemeler</h3>
                    <p class="card-text">Her sabah yerel üreticilerden en taze sebzeleri seçiyoruz.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h3 class="card-title">👨‍🍳 Usta Eller</h3>
                    <p class="card-text">Yemeklerimiz 20 yıllık tecrübeye sahip şeflerimiz tarafından hazırlanır.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h3 class="card-title">🚚 Hızlı Servis</h3>
                    <p class="card-text">Sıcak ve hızlı servis anlayışımızla lezzet kapınızda.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <a asp-controller="Yemekler" asp-action="Menu" class="btn btn-danger btn-lg px-5">Menüyü İncele &rarr;</a>
    </div>
</div>