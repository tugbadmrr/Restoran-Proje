@model LezzetDuragi.Models.Yemek

@{
    ViewData["Title"] = "Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow border-warning">
            <div class="card-header bg-warning text-dark">
                <h3 class="card-title mb-0">✏️ Yemeği Düzenle</h3>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    
                    <input type="hidden" asp-for="EklenmeTarihi" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Yemek Adı</label>
                        <input asp-for="Ad" class="form-control" />
                        <span asp-validation-for="Ad" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Fiyat (₺)</label>
                        <input asp-for="Fiyat" class="form-control" type="text" placeholder="Örn: 150.50" />
                        <span asp-validation-for="Fiyat" class="text-danger"></span>
                        <small class="text-muted">Lütfen kuruşları nokta (.) ile ayırınız.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Açıklama</label>
                        <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Aciklama" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-warning btn-lg">💾 Güncelle Kaydet</button>
                        <a asp-action="Index" class="btn btn-secondary">İptal / Listeye Dön</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}