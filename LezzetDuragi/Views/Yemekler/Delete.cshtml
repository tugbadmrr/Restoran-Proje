@model LezzetDuragi.Models.Yemek

@{
    ViewData["Title"] = "Sil";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow border-danger">
            <div class="card-header bg-danger text-white text-center">
                <h3>⚠️ Yemeği Silmek Üzeresin!</h3>
            </div>
            <div class="card-body text-center">
                <h4 class="mb-4">"@Model.Ad" isimli yemeği gerçekten silmek istiyor musun?</h4>
                
                <div class="bg-light p-3 rounded mb-3 text-start">
                    <p><strong>Fiyat:</strong> @Model.Fiyat ₺</p>
                    <p><strong>Açıklama:</strong> @Model.Aciklama</p>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger btn-lg w-100 mb-2">Evet, Sil gitsin!</button>
                    <a asp-action="Index" class="btn btn-secondary w-100">Hayır, Vazgeçtim</a>
                </form>
            </div>
        </div>
    </div>
</div>