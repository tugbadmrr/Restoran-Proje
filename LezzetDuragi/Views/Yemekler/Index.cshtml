@model IEnumerable<LezzetDuragi.Models.Yemek>

@{
    ViewData["Title"] = "Menü";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6">🍽️ Restoran Menüsü</h1>
        <a asp-action="Create" class="btn btn-success btn-lg">
            + Yeni Yemek Ekle
        </a>
    </div>

    <table class="table table-hover table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Yemek Adı</th>
                <th>Fiyatı</th>
                <th>Açıklama</th>
                <th>Eklenme Tarihi</th>
                <th style="width: 250px;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td class="fw-bold">@item.Ad</td>
                    <td class="text-success fw-bold">@item.Fiyat ₺</td>
                    <td>@item.Aciklama</td>
                    <td>@item.EklenmeTarihi.ToString("dd.MM.yyyy")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">✏️ Düzenle</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">👀 Detay</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">🗑️ Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>